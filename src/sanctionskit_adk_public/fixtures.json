        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "method": {
            "default": "get",
            "type": "string",
            "enum": [
              "get",
              "post",
              "put",
              "patch",
              "delete"

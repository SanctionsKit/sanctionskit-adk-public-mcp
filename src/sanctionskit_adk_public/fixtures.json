{
  "notice": "Synthetic offline response fixtures. Tool discovery schemas captured from the public endpoint on 2026-10-14; responses are illustrative and do not assert current source coverage.",
  "tools": [
    {
      "name": "search_docs",
      "title": "Search SanctionsKit documentation",
      "description": "Find current integration documentation and guides by keyword. Returns document slugs for get_doc. Public; no account needed.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      },
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    },
    {
